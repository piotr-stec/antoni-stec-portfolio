# Gmail Configuration for Contact Form
# 1. Włącz 2-Step Verification w swoim koncie Google
# 2. Wejdź na: https://myaccount.google.com/apppasswords
# 3. Wygeneruj App Password dla "Mail"
# 4. Użyj tego hasła poniżej (nie używaj normalnego hasła do konta!)

GOOGLE_EMAIL=twoj.email@gmail.com
GOOGLE_APP_PASSWORD=twoj_app_password_tutaj
RECIPIENT_EMAIL=kontakt@antek-foto.pl
